{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^24.22.1 || ^26.12.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "npm run test:unit && npm run test:component",
    "test:unit": "node --test tests/*.test.js",
    "test:component": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "chart.js": "^4.6.1",
    "pinia": "^4.1.0",
    "vue": "^3.5.45",
    "vue-chartjs": "^5.3.4"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "//": "親依存が未対応のminimatch脆弱性への一時対策。上流対応後はjs-beautify配下のoverridesを解除する。",
  "overrides": {
    "js-beautify": {
      "glob": "^14.0.3",
      "editorconfig": {
        "minimatch": "^11.0.4"
      }
    }
  }
}
