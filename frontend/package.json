    "jsdom": "^31.0.1",
    "postcss": "^8.5.33",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "picomatch": "file:vendor/picomatch",
    "fill-range": "7.1.1"
  },
  "//": "\u89aa\u4f9d\u5b58\u304c\u672a\u5bfe\u5fdc\u306eminimatch\u8106\u5f31\u6027\u3078\u306e\u4e00\u6642\u5bfe\u7b56\u3002\u4e0a\u6d41\u5bfe\u5fdc\u5f8c\u306fjs-beautify\u914d\u4e0b\u306eoverrides\u3092\u89e3\u9664\u3059\u308b\u3002",
