+/* The mask extents store the exclusive bottom after initialization. For
+ * the stack mask, extents.y advances as rows are cleared. */
+static cairo_bool_t
+mask_spans_fit (const cairo_image_span_renderer_t *r, int y, int height,
+                const cairo_half_open_span_t *spans, unsigned count)
+{
+    const cairo_rectangle_int_t *extents = &r->u.mask.extents;
+
+    if (y < extents->y || height < 0 ||
+        (int64_t)y + height > extents->height)
+        return FALSE;
+    if (count == 0)
+        return TRUE;
+    if (count < 2 || spans[0].x < extents->x ||
+        spans[count - 1].x > (int64_t)extents->x + extents->width)
+        return FALSE;
+    for (unsigned i = 1; i < count; i++) {
+        if (spans[i].x < spans[i - 1].x)
+            return FALSE;
+    }
+    return TRUE;
+}
