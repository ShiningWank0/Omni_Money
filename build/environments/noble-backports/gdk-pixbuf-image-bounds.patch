+static gboolean
+decode_indexed_line (struct ico_progressive_state *context, GError **error)
+{
+	gint row = context->Header.Negative ? context->Lines : context->Header.height - context->Lines - 1;
+	guchar *pixels = gdk_pixbuf_get_pixels (context->pixbuf) +
+	                 (gsize) row * gdk_pixbuf_get_rowstride (context->pixbuf);
+	const guchar *palette = context->HeaderBuf + context->DIBoffset + INFOHEADER_SIZE;
+	for (gint x = 0; x < context->Header.width; x++) {
+		guint index;
+		if (context->Type == 8)
+			index = context->LineBuf[x];
+		else if (x & 1)
+			index = context->LineBuf[x / 2] & 15;
+		else
+			index = context->LineBuf[x / 2] >> 4;
+		if (index >= context->palette_entries) {
+			g_set_error_literal (error, GDK_PIXBUF_ERROR, GDK_PIXBUF_ERROR_CORRUPT_IMAGE,
+			                     _("Invalid palette index in icon"));
+			return FALSE;
+		}
+		pixels[0] = palette[index * 4 + 2];
+		pixels[1] = palette[index * 4 + 1];
+		pixels[2] = palette[index * 4];
+		pixels[3] = 0xff;
+		pixels += 4;
+	}
+	return TRUE;
 }
 
