# TrueNAS/Linuxでは /mnt/<pool>/apps/omni-money など永続Datasetを指定し、
# コンテナUID/GID 10001（または明示したuser）だけが書けるACLにする。
OMNI_DATA_DIR=./data
# 本番更新ではv1.1.0のような固定tag（またはdigest）を指定する。
OMNI_IMAGE=omni-money:local
# 上記data rootがLUKS2/ZFS native encryption等で保護済みであることを
# 記録した期限付きattestation。作成手順: docs/at-rest-encryption.md
OMNI_AT_REST_ATTESTATION_FILE=./secrets/omni_data_at_rest.json
# Root-owned host contract for safe-update. It must name the encrypted volume,
# this host data root, and its fixed checkpoint sibling.
OMNI_UPDATE_ATTESTATION_FILE=./secrets/omni_update_attestation.json
# control-plane SQLCipherの独立32 byte鍵。ユーザーvaultのDEKとは別物。
OMNI_CONTROL_DB_ENCRYPTION_KEY_FILE=./secrets/control-database.key
# compose.bootstrap.yamlで初回Admin作成だけを許可する32 byte以上の
# base64url token。初回設定後はbase Composeで再作成して安全にretireする。
OMNI_INITIAL_ADMIN_SETUP_TOKEN_FILE=./secrets/initial-admin-setup.token
AUTH_KDF_CONCURRENCY=2
# compose.local.yamlで使うlocalhost側ポート。
OMNI_WEB_PORT=4000

# コンテナの資源上限。画像処理を含む通常利用向けの既定値。
OMNI_CPU_LIMIT=2.0
OMNI_MEMORY_LIMIT=1g
OMNI_PIDS_LIMIT=256
OMNI_TMPFS_SIZE=128m

# Pangolin/Newt専用network。既存subnetと衝突する場合は4値を同時に変更する。
OMNI_PANGOLIN_NETWORK=omni-money-pangolin
OMNI_PANGOLIN_SUBNET=172.30.240.0/28
OMNI_MONEY_IP=172.30.240.2

SESSION_MAX_AGE_HOURS=8
SESSION_IDLE_TIMEOUT_MINUTES=15
# CSV入出力等の高影響操作で、パスワード再確認を使い回せる時間。
# 通常の閲覧・編集に対する再認証間隔ではない。
SESSION_REAUTH_MAX_AGE_MINUTES=5
SESSION_MAX_CONCURRENT=3
# Newtを上記networkの172.30.240.3へ固定する。広いLAN CIDRを指定しない。
TRUSTED_PROXIES=172.30.240.3/32
HTTPS_REDIRECT_HOST=
# Pangolinで公開する正確なFQDN。未設定ならbase Composeは起動時に拒否される。
ALLOWED_HOSTS=money.example.com
CORS_ALLOWED_ORIGINS=
# WebAuthn/Pangolinの公開host。RP IDにはschemeやportを含めない。
PASSKEY_RP_ID=money.example.com
PASSKEY_ORIGINS=https://money.example.com

# Bound Docker json-file logs even if an authenticated client floods denials.
OMNI_LOG_MAX_SIZE=10m
OMNI_LOG_MAX_FILES=3
