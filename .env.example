# bcryptハッシュ。平文パスワードは設定しない。
AUTH_PASSWORD_HASH='$2y$12$replace_with_your_bcrypt_hash'

# TrueNAS/Linuxでは /mnt/<pool>/apps/omni-money など永続Datasetを指定し、
# コンテナUID/GID 10001（または明示したuser）だけが書けるACLにする。
OMNI_DATA_DIR=./data
# compose.local.yamlで使うlocalhost側ポート。
OMNI_WEB_PORT=4000
OMNI_AI_PORT=4001

# コンテナの資源上限。画像処理を含む通常利用向けの既定値。
OMNI_CPU_LIMIT=2.0
OMNI_MEMORY_LIMIT=1g
OMNI_PIDS_LIMIT=256
OMNI_TMPFS_SIZE=128m

# compose.ai.yamlを使う場合のホスト側secretファイル（すべてリポジトリ外で管理）。
AI_CREDENTIALS_SECRET_FILE=./secrets/ai_credentials.json
AI_CONSOLE_TOKEN_SECRET_FILE=./secrets/ai_console_token
AI_AUDIT_HMAC_SECRET_FILE=./secrets/ai_audit_hmac.json
AI_TLS_CA_SECRET_FILE=./secrets/ai_ca.pem
AI_TLS_SERVER_CERT_SECRET_FILE=./secrets/ai_server_cert.pem
AI_TLS_SERVER_KEY_SECRET_FILE=./secrets/ai_server_key.pem
AI_TLS_CLIENT_CERT_SECRET_FILE=./secrets/ai_client_cert.pem
AI_TLS_CLIENT_KEY_SECRET_FILE=./secrets/ai_client_key.pem

# Pangolin/Newt専用network。既存subnetと衝突する場合は4値を同時に変更する。
OMNI_PANGOLIN_NETWORK=omni-money-pangolin
OMNI_PANGOLIN_SUBNET=172.30.240.0/28
OMNI_MONEY_IP=172.30.240.2

SESSION_MAX_AGE_HOURS=8
SESSION_IDLE_TIMEOUT_MINUTES=15
# CSV入出力・復元等の高影響操作で、パスワード再確認を使い回せる時間。
# 通常の閲覧・編集やTOTPの再入力間隔ではない。
SESSION_REAUTH_MAX_AGE_MINUTES=5
SESSION_MAX_CONCURRENT=3
# Composeでは /app/data 配下のコンテナ内パスを指定する。Pangolinとは別のseedを使う。
AUTH_TOTP_SECRET_FILE=
AUTH_REQUIRE_TOTP=false
# Newtを上記networkの172.30.240.3へ固定する。広いLAN CIDRを指定しない。
TRUSTED_PROXIES=172.30.240.3/32
HTTPS_REDIRECT_HOST=
# Pangolinで公開する正確なFQDN。未設定ならbase Composeは起動時に拒否される。
ALLOWED_HOSTS=money.example.com
CORS_ALLOWED_ORIGINS=
