# Deny by default. Only files explicitly required by Dockerfile are sent to
# the builder, so financial databases, WAL/journals, exports, credentials, TLS
# keys, and unrelated workspace files cannot enter remote builders or caches.
**

!Dockerfile
!go.mod
!go.sum
!LICENSE
!licenses/
!licenses/approved.json
!licenses/targets.json
!server.go

!backend/
!backend/**

!cmd/
!cmd/omni-totp/
!cmd/omni-totp/**
!cmd/verify-public-assets/
!cmd/verify-public-assets/main.go
!cmd/verify-licenses/
!cmd/verify-licenses/main.go

!scripts/
!scripts/build-sqlcipher-linux.sh
!scripts/oss-notices.mjs
!scripts/record-image-licenses.sh
!scripts/verify-picomatch-patch.mjs
!scripts/security-patches/
!scripts/security-patches/picomatch.json

!frontend/
!frontend/package.json
!frontend/package-lock.json
!frontend/vendor/
!frontend/vendor/picomatch/
!frontend/vendor/picomatch/index.js
!frontend/vendor/picomatch/posix.js
!frontend/vendor/picomatch/package.json
!frontend/vendor/picomatch/LICENSE
!frontend/vendor/picomatch/README.md
!frontend/vendor/picomatch/LOCAL-PATCH.md
!frontend/vendor/picomatch/lib/
!frontend/vendor/picomatch/lib/constants.js
!frontend/vendor/picomatch/lib/parse.js
!frontend/vendor/picomatch/lib/picomatch.js
!frontend/vendor/picomatch/lib/scan.js
!frontend/vendor/picomatch/lib/utils.js
!frontend/index.html
!frontend/vite.config.js
!frontend/build/
!frontend/build/public-assets.mjs
!frontend/build/oss-inventory.mjs
!frontend/src/
!frontend/src/**

# Keep sensitive/runtime patterns excluded even if they appear below an
# allow-listed source directory.
**/data/**
**/secrets/**
**/*.db
**/*.db-*
**/*.db-journal
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.secret
**/*_token
**/*_credentials.json
