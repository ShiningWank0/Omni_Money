# Deny by default. Only files explicitly required by Dockerfile are sent to
# the builder, so financial databases, WAL/journals, exports, credentials, TLS
# keys, and unrelated workspace files cannot enter remote builders or caches.
**

!Dockerfile
!go.mod
!go.sum
!server.go

!backend/
!backend/**

!cmd/
!cmd/omni-totp/
!cmd/omni-totp/**

!scripts/
!scripts/build-sqlcipher-linux.sh

!frontend/
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/vite.config.js
!frontend/src/
!frontend/src/**

# Keep sensitive/runtime patterns excluded even if they appear below an
# allow-listed source directory.
**/data/**
**/secrets/**
**/*.db
**/*.db-*
**/*.db-journal
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.secret
**/*_token
**/*_credentials.json
